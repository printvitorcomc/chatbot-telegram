    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function read(value) {\n  if (!value) return null;\n\n  if (typeof value === 'string') {\n    const text = value.trim()\n      .replace(/^```(?:json)?\\s*|\\s*```$/gi, '')\n      .trim();\n\n    if (!text) return null;\n\n    try {\n      return read(JSON.parse(text));\n    } catch {\n      return /^[{\\[]/.test(text) ? null : text;\n    }\n  }\n\n  if (Array.isArray(value)) {\n    return value.map(read).find(Boolean) || null;\n  }\n\n  if (typeof value !== 'object') return null;\n\n  if (value.ok === false || value.error ||\n      value.refusal || value.type === 'refusal' ||\n      value.thought === true) {\n    return null;\n  }\n\n  if (value.finishReason && value.finishReason !== 'STOP') {\n    return null;\n  }\n\n  const fields = [\n    'message', 'output_text', 'output',\n    'candidates', 'content', 'parts',\n    'text', 'choices', 'response'\n  ];\n\n  return fields.map(key => read(value[key]))\n    .find(Boolean) || null;\n}\n\nconst message = read($json);\n\nreturn {\n  json: {\n    message,\n    ok: Boolean(message)\n  }\n};"
      },
