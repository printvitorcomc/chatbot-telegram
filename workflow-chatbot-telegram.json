        "jsCode": "const code = Number($json.cod);\nconst notFound = code === 404;\nreturn { json: {\n  error_code: Number.isFinite(code) ? code : 'INVALID_RESPONSE',\n  error_type: notFound ? 'CITY_NOT_FOUND' : 'API_ERROR',\n  message: notFound\n    ? '❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).'\n    : '⚡ Zeus está com problemas no Olimpo. Tente novamente mais tarde.',\n  notify_admin: !notFound\n} };"
